{
  "name": "motivo",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "inspect": "node scripts/inspect.mjs",
    "providers": "python scripts/providers.py status",
    "connect": "python scripts/providers.py connect",
    "provider:check": "python scripts/providers.py check",
    "gallery": "node scripts/gallery.mjs",
    "test:clean": "node --test tests/clean-text.test.cjs",
    "inspect:clean": "node scripts/inspect-clean.mjs",
    "gallery:docs": "python scripts/gallery_docs.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/media-utils": "4.0.547",
    "@remotion/transitions": "4.0.547",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.547",
    "@remotion/bundler": "4.0.547",
    "@remotion/renderer": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  },
  "description": "Turn your agent into a director-led video studio. By Pawarna.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
